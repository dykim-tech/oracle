#!/bin/bash
# =============================================================================
#  Oracle 19c on Rocky Linux 8.10 - Installation Configuration
#  가지고 계신 두 파일만으로 설치하는 구성:
#    - LINUX.X64_193000_db_home.zip
#    - oracle-database-preinstall-19c-1.0-1.el7.x86_64.rpm
# =============================================================================

# ----- 대상 OS -----
export TARGET_OS="rocky8"                # rocky8 | rocky9

# ----- Oracle 계정/그룹 -----
export ORACLE_USER="oracle"
export ORACLE_UID="54321"
export OINSTALL_GID="54321"
export DBA_GID="54322"
export OPER_GID="54323"
export BACKUPDBA_GID="54324"
export DGDBA_GID="54325"
export KMDBA_GID="54326"
export RACDBA_GID="54330"

# ----- Oracle 디렉터리 -----
export ORACLE_BASE="/u01/app/oracle"
export ORACLE_HOME="/u01/app/oracle/product/19.0.0/dbhome_1"
export ORA_INVENTORY="/u01/app/oraInventory"
export ORADATA_DIR="/u02/oradata"
export FRA_DIR="/u03/fra"

# ----- 데이터베이스 파라미터 -----
# ⚠ ORACLE_SID 는 반드시 대문자로 지정 (소문자 SID 는 스크립트/도구 호환성 이슈 유발)
export ORACLE_SID="ORCLCDB"
export ORACLE_PDB="ORCLPDB1"
export DB_CHARSET="AL32UTF8"
export DB_NCHARSET="AL16UTF16"
# 서버 RAM 에 맞게 조정 (권장: 물리 RAM 의 40~50%)
#   4GB RAM  → 1600
#   8GB RAM  → 3600
#   16GB RAM → 8000
export DB_TOTAL_MEMORY_MB="1600"
export DB_REDO_SIZE_MB="100"
export DB_FRA_SIZE_MB="4096"
export DB_ARCHIVE_MODE="true"

# ----- 비밀번호 -----
# 저장소에는 비밀번호를 보관하지 않습니다. install.sh가 필요한 시점에
# 안전하게 입력받거나, sudo -E 실행 전에 환경변수로 전달할 수 있습니다.
export SYS_PASSWORD="${SYS_PASSWORD:-}"
export SYSTEM_PASSWORD="${SYSTEM_PASSWORD:-}"
export PDB_ADMIN_PASSWORD="${PDB_ADMIN_PASSWORD:-}"

# ----- 설치 파일 경로 -----
export INSTALL_STAGE="/tmp/oracle_install"
export DB_ZIP_FILE="${INSTALL_STAGE}/LINUX.X64_193000_db_home.zip"

# ----- RU 패치 (없어도 됨. Rocky 8 에서는 base 19.3 로도 설치 가능) -----
export APPLY_RU="false"                # true 로 하려면 아래 두 파일 추가 필요
export RU_ZIP_FILE="${INSTALL_STAGE}/p35643107_190000_Linux-x86-64.zip"
export OPATCH_ZIP_FILE="${INSTALL_STAGE}/p6880880_190000_Linux-x86-64.zip"
export RU_PATCH_NUMBER="35643107"

# ----- preinstall RPM (el7 버전) -----
#   Rocky 8 에서는 --nodeps 로 강제 설치 시 대부분 정상 동작
#   또는 인터넷 접근 가능하면 OL8 저장소의 preinstall 을 사용 (권장)
export PREINSTALL_RPM="${INSTALL_STAGE}/oracle-database-preinstall-19c-1.0-1.el7.x86_64.rpm"
export USE_LOCAL_PREINSTALL_RPM="true"     # true : 가지고 있는 el7 RPM 사용
export USE_OL8_REPO_PREINSTALL="true"      # true : 인터넷 가능 시 OL8 저장소 우선 사용

# ----- 네트워크 -----
export DB_PORT="1521"
export EM_PORT="5500"
export DB_HOSTNAME="$(hostname -f 2>/dev/null || hostname)"

# ----- 옵션 플래그 -----
export SKIP_PRECHECK="false"
export IGNORE_PREREQ="true"                # Rocky 는 미인증 OS 이므로 true
export CV_ASSUME_DISTID_VAL="OEL8"          # Rocky 8 → OEL8 로 위장
export CONFIGURE_FIREWALL="true"
export CONFIGURE_SELINUX_PERMISSIVE="true"

# ----- 로그 -----
export LOG_DIR="/var/log/oracle-install"
export LOG_FILE="${LOG_DIR}/install-$(date +%Y%m%d-%H%M%S).log"
